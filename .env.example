# Supabase (Postgres + PostGIS)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Clerk (auth)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Stripe (Billing + Customer Portal — subscriptions only, no Connect)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_ID_MONTHLY=
STRIPE_PRICE_ID_ANNUAL=
STRIPE_PRICE_ID_LIFETIME=

# Map: base tiles use MapLibre GL + free CARTO dark style (no key required).
# Mapbox is an optional future upgrade — swap STYLE_URL in components/map-explorer.tsx.

# Cloudinary (media)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Observability
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Email
RESEND_API_KEY=

# AI guide (Atlas Guide chatbot). Uses the Anthropic Messages API.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Conditions cron: protects /api/cron/conditions. Vercel Cron sends it as a
# Bearer token automatically when set on the project.
CRON_SECRET=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Comma-separated Clerk user IDs allowed into /admin/moderation
ADMIN_USER_IDS=
